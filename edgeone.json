{
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120
    }
  },
  "schedules": [
    {
      "name": "kira-refill-konachan",
      "cron": "13 0 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "konachan"
      }
    },
    {
      "name": "kira-refill-yande",
      "cron": "13 2 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "yande"
      }
    },
    {
      "name": "kira-refill-miyoushe_cos",
      "cron": "13 4 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "miyoushe_cos"
      }
    },
    {
      "name": "kira-refill-miyoushe_art",
      "cron": "13 6 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "miyoushe_art"
      }
    },
    {
      "name": "kira-refill-nekosia",
      "cron": "13 8 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "nekosia"
      }
    },
    {
      "name": "kira-refill-e_shuushuu",
      "cron": "13 10 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/replenish",
      "method": "POST",
      "payload": {
        "source": "e_shuushuu"
      }
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist"
}
